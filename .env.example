# ---------------------------------------------------------------------------
# Callback form delivery. Copy this file to `.env` and fill ONE of the two.
# Vite only exposes variables prefixed with VITE_, and they are baked into the
# JS bundle at build time — never put a secret (SMTP password, bot token with
# admin rights, private API key) in here.
# ---------------------------------------------------------------------------

# Option 1 — no backend needed. Get a free access key at https://web3forms.com/
# by entering the inbox that should receive the requests, e.g. info@sevendates.uz.
# The key is public by design: it only allows submitting to that one inbox.
VITE_WEB3FORMS_KEY=

# Option 2 — your own endpoint (serverless function, CRM webhook, backend API).
# Receives a JSON POST: { name, phone, email, message, subject, recipients, page }
# Takes priority over the key above when both are set.
VITE_FORM_ENDPOINT=
