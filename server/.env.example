# Server-side only. NEVER prefix these with VITE_ and never put them in the
# frontend .env — Vite bakes VITE_* into the public JS bundle.

SMTP_HOST=mail.sevendates.uz
SMTP_PORT=465
SMTP_USER=relay@sevendates.uz
SMTP_PASS=

# Where callback requests are delivered. Comma-separated for several inboxes.
MAIL_TO=info@sevendates.uz,partner@sevendates.uz,partner@sevendates.ru

# Only needed if the API is served from a different origin than the site.
# Same-origin behind nginx (recommended) needs no value here.
ALLOWED_ORIGIN=

PORT=8787

# Первая учётная запись для /admin — создаётся только если ещё нет ни одной.
# После создания эти две строки можно очистить: пароли хранятся
# хешированными в data/users.json.
# SESSION_SECRET: openssl rand -hex 32
ADMIN_USERNAME=
ADMIN_PASSWORD=
SESSION_SECRET=

# Абсолютный адрес сайта — нужен для canonical, OG и sitemap.
SITE_ORIGIN=https://sevendates.ru
